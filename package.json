{
  "name": "grund",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Everything as code monorepo for portfolio operations",
  "author": "Lukas Andersen",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@grund/api' dev & bun run --filter '@grund/web' dev",
    "dev:api": "bun run --filter '@grund/api' dev",
    "dev:web": "bun run --filter '@grund/web' dev",
    "db:generate": "bun run --filter '@grund/db' generate",
    "db:migrate": "bun run --filter '@grund/db' migrate",
    "db:push": "bun run --filter '@grund/db' push",
    "db:studio": "bun run --filter '@grund/db' studio",
    "seed": "bun run --filter '@grund/api' seed",
    "build": "bun run --filter '*' build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.8.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.0.17"
  }
}
