{
  "name": "@grund/finance-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Finance agent — ingests transactions from an aggregator, categorizes spending, and exposes a read API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@grund/logger": "workspace:*",
    "fastify": "^5.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pino-pretty": "^13",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@vitest/ui": "^4.0.18",
    "tsx": "^4.6.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
