{
  "name": "@grund/heartbeat-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Heartbeat monitoring agent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.10.9",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.6.0",
    "tsx": "^4.6.0"
  }
}
