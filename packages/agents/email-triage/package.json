{
  "name": "@grund/email-triage-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Email triage agent — classifies, labels, archives, and drafts replies",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.9.0",
    "fastify": "^5.0.0",
    "pg": "^8.11.3",
    "redis": "^4.6.10",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.10.9",
    "@vitest/ui": "^4.0.18",
    "tsx": "^4.6.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
