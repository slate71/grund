{
  "name": "@grund/coparent-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SMS-based co-parent logistics coordination agent",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "seed": "bun src/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@grund/db": "workspace:*",
    "drizzle-orm": "^0.39.0",
    "fastify": "^5.0.0",
    "googleapis": "^144.0.0",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.5",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.6.0",
    "vitest": "^4.0.18"
  }
}
